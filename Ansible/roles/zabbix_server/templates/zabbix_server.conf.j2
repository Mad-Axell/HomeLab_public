{{ ansible_managed | comment }}
# Owned by the zabbix_server Ansible role.
# Принадлежит роли Ansible zabbix_server.

# LogFile, PidFile, AlertScriptsPath и FpingLocation задаёт сам пакет Debian в
# zabbix_server.conf, и пути у него свои (/var/log/zabbix-server/). Здесь они не
# повторяются: дублировать значение, чтобы задать то же самое, значит завести второе
# место, где его придётся менять.
ListenPort={{ zabbix_server_listen_port }}

DBHost={{ zabbix_server_database_host }}
DBPort={{ zabbix_server_database_port }}
DBName={{ zabbix_server_database_name }}
DBUser={{ zabbix_server_database_user }}
DBPassword={{ lookup('ansible.builtin.vars', zabbix_server_database_password_var) }}

# Too few pollers do not fail, they delay. An exhausted queue holds back every check on
# every host and surfaces as hosts going unavailable in waves, which reads as a network
# problem rather than as a capacity one.
# Нехватка поллеров не ломает, а задерживает. Исчерпанная очередь придерживает каждую
# проверку на каждом хосте и проявляется волнами недоступных хостов, что читается как
# проблема сети, а не как нехватка ёмкости.
StartPollers={{ zabbix_server_start_pollers }}
StartPollersUnreachable={{ zabbix_server_start_pollers_unreachable }}
StartTrappers={{ zabbix_server_start_trappers }}
StartDiscoverers={{ zabbix_server_start_discoverers }}

CacheSize={{ zabbix_server_cache_size }}
HistoryCacheSize={{ zabbix_server_history_cache_size }}
ValueCacheSize={{ zabbix_server_value_cache_size }}

{% for name, value in zabbix_server_extra_settings.items() %}
{{ name }}={{ value }}
{% endfor %}
