TZ={{ immich_timezone }}
UPLOAD_LOCATION=/data
DB_HOSTNAME={{ immich_db_host }}
DB_PORT={{ immich_db_port }}
DB_USERNAME={{ immich_db_user }}
DB_PASSWORD={{ lookup('ansible.builtin.vars', immich_db_password_var) }}
DB_DATABASE_NAME={{ immich_db_name }}
REDIS_HOSTNAME={{ immich_redis_host }}
REDIS_PORT={{ immich_redis_port }}
{% if immich_redis_password_var is not none %}
REDIS_PASSWORD={{ lookup('ansible.builtin.vars', immich_redis_password_var) }}
{% endif %}
