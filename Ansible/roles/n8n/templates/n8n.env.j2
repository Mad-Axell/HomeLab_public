GENERIC_TIMEZONE={{ n8n_timezone }}
TZ={{ n8n_timezone }}
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST={{ n8n_db_host }}
DB_POSTGRESDB_PORT={{ n8n_db_port }}
DB_POSTGRESDB_DATABASE={{ n8n_db_name }}
DB_POSTGRESDB_USER={{ n8n_db_user }}
DB_POSTGRESDB_PASSWORD={{ lookup('ansible.builtin.vars', n8n_db_password_var) }}
N8N_ENCRYPTION_KEY={{ lookup('ansible.builtin.vars', n8n_encryption_key_var) }}
N8N_PROTOCOL={{ n8n_protocol }}
N8N_SECURE_COOKIE={{ 'true' if n8n_secure_cookie else 'false' }}
{% if n8n_hostname is not none and n8n_hostname != '' %}
N8N_HOST={{ n8n_hostname }}
{% endif %}
{% if n8n_webhook_url is not none and n8n_webhook_url != '' %}
WEBHOOK_URL={{ n8n_webhook_url }}
{% endif %}
