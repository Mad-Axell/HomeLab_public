{{ ansible_managed | comment }}
# Owned by the grafana Ansible role.
# Принадлежит роли Ansible grafana.

[server]
http_port = {{ grafana_http_port }}
domain = {{ grafana_domain }}
{% if grafana_root_url is not none and (grafana_root_url | string | trim | length) > 0 %}
root_url = {{ grafana_root_url }}
{% endif %}

[security]
# The password is applied once, when Grafana creates the admin account on
# first start; changing it here later does not update the existing account.
# Пароль применяется один раз, когда Grafana создаёт учётную запись при
# первом старте; его смена здесь позже не обновляет существующую учётную
# запись.
admin_user = {{ grafana_admin_user }}
admin_password = {{ lookup("ansible.builtin.vars", grafana_admin_password_var) }}
{% if grafana_database_type == "postgres" %}

[database]
# The password value is resolved from the variable named by
# grafana_database_password_var; only the variable name lives in host_vars.
# Значение пароля разрешается из переменной, чьё имя задано в
# grafana_database_password_var; в host_vars хранится только имя переменной.
type = postgres
host = {{ grafana_database_host }}:{{ grafana_database_port }}
name = {{ grafana_database_name }}
user = {{ grafana_database_user }}
password = {{ lookup("ansible.builtin.vars", grafana_database_password_var) }}
{% endif %}
