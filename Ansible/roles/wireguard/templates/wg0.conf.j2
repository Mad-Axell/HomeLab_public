# Managed by Ansible role wireguard - manual changes will be overwritten
[Interface]
Address = {{ wireguard_tunnel_address }}
ListenPort = {{ wireguard_listen_port }}
PrivateKey = {{ wireguard_resolved_private_key }}
{% for peer in wireguard_resolved_peers %}

# {{ peer.name }}{{ ' [' ~ peer.group ~ ']' if peer.group is defined and peer.group else '' }}
[Peer]
PublicKey = {{ peer.resolved_public_key }}
{% if peer.resolved_preshared_key is defined -%}
PresharedKey = {{ peer.resolved_preshared_key }}
{% endif -%}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.persistent_keepalive is defined -%}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif -%}
{% endfor %}
