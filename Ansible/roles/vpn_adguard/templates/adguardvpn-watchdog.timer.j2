# {{ ansible_managed }}
# Ticks the watchdog oneshot. The first run happens one interval after boot so
# the tunnel service gets time to connect before it is judged.

[Unit]
Description=AdGuard VPN tunnel watchdog timer
Documentation=https://adguard-vpn.com/kb/adguard-vpn-for-linux/

[Timer]
OnBootSec={{ vpn_adguard_watchdog_interval_sec }}s
OnUnitActiveSec={{ vpn_adguard_watchdog_interval_sec }}s
AccuracySec=10s

[Install]
WantedBy=timers.target
