#!/bin/bash
# {{ ansible_managed }}
# Restarts the AdGuard VPN tunnel when the client is wedged. The tunnel unit is
# oneshot+RemainAfterExit, so systemd reports it active even when the client
# daemon is dead; this script checks the client status and a real probe through
# the tunnel interface instead.

set -u

SERVICE="{{ vpn_adguard_service_name }}"
CLI="{{ vpn_adguard_binary_path }}"
TUN_IF="{{ vpn_adguard_tunnel_interface }}"
PROBE_URL="{{ vpn_adguard_watchdog_probe_url }}"
PROBE_TIMEOUT="{{ vpn_adguard_watchdog_probe_timeout_sec }}"
FAIL_THRESHOLD="{{ vpn_adguard_watchdog_fail_count }}"
MAX_RESTARTS="{{ vpn_adguard_watchdog_max_restarts }}"
WINDOW_SEC="{{ vpn_adguard_watchdog_window_sec }}"
STATE_DIR="/run/adguardvpn-watchdog"
FAIL_FILE="$STATE_DIR/fails"
RESTARTS_FILE="$STATE_DIR/restarts"

mkdir -p "$STATE_DIR"
now=$(date +%s)
fails=$(cat "$FAIL_FILE" 2>/dev/null || echo 0)

log() { echo "adguardvpn-watchdog: $*"; }

# Do nothing while the operator keeps the tunnel stopped: a deliberate stop is
# not a failure and must not be undone by the watchdog.
if ! systemctl is-active --quiet "$SERVICE"; then
    log "tunnel service is not active; nothing to check"
    echo 0 > "$FAIL_FILE"
    exit 0
fi

status_ok() {
    "$CLI" status 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -q '^Connected'
}
probe_ok() {
    curl -fsS -o /dev/null -m "$PROBE_TIMEOUT" --interface "$TUN_IF" "$PROBE_URL"
}

if status_ok && probe_ok; then
    [ "$fails" -gt 0 ] && log "tunnel recovered after $fails failed check(s)"
    echo 0 > "$FAIL_FILE"
    exit 0
fi

fails=$((fails + 1))
echo "$fails" > "$FAIL_FILE"
if status_ok; then
    log "check $fails/$FAIL_THRESHOLD failed: probe through $TUN_IF failed"
else
    log "check $fails/$FAIL_THRESHOLD failed: client status is not Connected"
fi

if [ "$fails" -lt "$FAIL_THRESHOLD" ]; then
    exit 0
fi

# Spend one restart from the sliding-window budget.
: >> "$RESTARTS_FILE"
: > "$RESTARTS_FILE.tmp"
while read -r ts; do
    [ -n "$ts" ] && [ $((now - ts)) -lt "$WINDOW_SEC" ] && echo "$ts"
done < "$RESTARTS_FILE" >> "$RESTARTS_FILE.tmp"
mv "$RESTARTS_FILE.tmp" "$RESTARTS_FILE"
recent=$(wc -l < "$RESTARTS_FILE" 2>/dev/null || echo 0)

if [ "$recent" -ge "$MAX_RESTARTS" ]; then
    log "restart budget exhausted: $recent restarts in ${WINDOW_SEC}s; manual intervention required"
    exit 1
fi

log "restarting $SERVICE (restart $((recent + 1))/$MAX_RESTARTS in ${WINDOW_SEC}s)"
echo "$now" >> "$RESTARTS_FILE"
echo 0 > "$FAIL_FILE"
systemctl restart "$SERVICE"
