{{ ansible_managed | comment }}
[Unit]
Description=NetBox WSGI service
Documentation=https://docs.netbox.dev/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ netbox_system_user }}
Group={{ netbox_system_user }}
WorkingDirectory={{ netbox_install_root }}
ExecStart={{ netbox_install_root }}/venv/bin/gunicorn --pid /var/tmp/netbox.pid --pythonpath {{ netbox_install_root }}/netbox --config {{ netbox_install_root }}/gunicorn.py netbox.wsgi
Restart=on-failure
RestartSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target
